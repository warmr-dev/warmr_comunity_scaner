APP_ENV=local
DATABASE_URL=sqlite:///./data/scanner.db

DISCOVERY_PROVIDERS=brave
BRAVE_SEARCH_API_KEY=
BRAVE_COUNTRY=us
BRAVE_SEARCH_LANG=en
# Hard cap: 200 requests ≈ $1 at $5/1k. 0 = unlimited.
BRAVE_MAX_REQUESTS=200
DISCOVERY_CONCURRENCY=1

USE_FETCH_QUEUE=false
SCANNER_MODE=run

PIPE_GEO=USA
PIPE_NICHE=software-engineering
PIPE_AUDIENCE=developers
PIPE_QUERIES=20
PIPE_PER_QUERY=20
PIPE_MAX_FETCH=200

HTTP_TIMEOUT_SECONDS=12
CRAWL_DOWNLOAD_DELAY_SECONDS=0
FETCH_CONCURRENCY=20

LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

WARMR_DATABASE_URL=
WARMR_SYNC_ENABLED=false
SYNC_VALUE_TIERS=high,medium
