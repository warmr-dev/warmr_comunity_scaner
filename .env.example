APP_ENV=local
DATABASE_URL=sqlite:///./data/scanner.db

DISCOVERY_PROVIDERS=searxng
SEARXNG_BASE_URL=http://localhost:8080
SEARXNG_LANGUAGE=en-US
DISCOVERY_CONCURRENCY=8

USE_FETCH_QUEUE=false
SCANNER_MODE=run

PIPE_GEO=USA
PIPE_NICHE=business
PIPE_AUDIENCE=professionals
PIPE_QUERIES=5
PIPE_PER_QUERY=15
PIPE_MAX_FETCH=50

HTTP_TIMEOUT_SECONDS=12
CRAWL_DOWNLOAD_DELAY_SECONDS=0
FETCH_CONCURRENCY=20

LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

WARMR_DATABASE_URL=
WARMR_SYNC_ENABLED=false
SYNC_VALUE_TIERS=high,medium
