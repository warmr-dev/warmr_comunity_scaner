APP_ENV=local
DATABASE_URL=sqlite:///./data/scanner.db
REDIS_URL=redis://localhost:6379/0

# Local MVP: seeds only. Add brave later when you have a key.
BRAVE_SEARCH_API_KEY=
SEARXNG_BASE_URL=http://localhost:8080
DISCOVERY_PROVIDERS=seeds

LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

WARMR_DATABASE_URL=
WARMR_SYNC_ENABLED=false
SYNC_VALUE_TIERS=high,medium

HTTP_TIMEOUT_SECONDS=20
CRAWL_DOWNLOAD_DELAY_SECONDS=1.0
