APP_ENV=local
DATABASE_URL=sqlite:///./data/scanner.db

# Mass discovery: Common Crawl + Hive (add dataforseo,brave,searxng as needed)
DISCOVERY_PROVIDERS=commoncrawl,hive
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_LANGUAGE=en-US
DISCOVERY_CONCURRENCY=2
DIRECTORY_MAX_CHANNELS_PER_SITE=40

# Common Crawl CDX
COMMONCRAWL_INDEX=latest
COMMONCRAWL_INDEX_OFFSET=0
COMMONCRAWL_DELAY_MS=500
COMMONCRAWL_PAGE_SIZE=400
COMMONCRAWL_MAX_PAGES_PER_PATTERN=25
COMMONCRAWL_MIN_LIKELIHOOD=0.45
COMMONCRAWL_PERSIST_RESUME=true

# Hive Index
HIVE_MAX_DETAIL_PAGES=800
HIVE_EXCLUDE_DISCORD_TELEGRAM=true

# Persist bulk hits before community upsert
SAVE_RAW_CANDIDATES=true
RAW_MIN_LIKELIHOOD=0.4

# Optional paid search (set key; 0 = unlimited)
BRAVE_SEARCH_API_KEY=
BRAVE_COUNTRY=us
BRAVE_SEARCH_LANG=en
BRAVE_MAX_REQUESTS=0

# Optional DataForSEO (cheap SERP expansion)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_MODE=live

# Harvest-first: collect invite links broadly, filter later
HARVEST_MODE=true
HARVEST_SKIP_ENRICH=true

USE_FETCH_QUEUE=false
SCANNER_MODE=run

PIPE_GEO=USA
PIPE_NICHE=harvest
PIPE_AUDIENCE=developers
PIPE_QUERIES=30
PIPE_PER_QUERY=50
PIPE_MAX_FETCH=500

HTTP_TIMEOUT_SECONDS=15
CRAWL_DOWNLOAD_DELAY_SECONDS=0.6
FETCH_CONCURRENCY=80

LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

WARMR_DATABASE_URL=
WARMR_SYNC_ENABLED=false
SYNC_VALUE_TIERS=high,medium
