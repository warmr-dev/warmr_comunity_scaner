APP_ENV=local
DATABASE_URL=sqlite:///./data/scanner.db

DISCOVERY_PROVIDERS=searxng
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_LANGUAGE=en-US
DISCOVERY_CONCURRENCY=1

USE_FETCH_QUEUE=false
SCANNER_MODE=run

PIPE_GEO=USA
PIPE_NICHE=software-engineering
PIPE_AUDIENCE=developers
PIPE_QUERIES=20
PIPE_PER_QUERY=25
PIPE_MAX_FETCH=100

HTTP_TIMEOUT_SECONDS=12
CRAWL_DOWNLOAD_DELAY_SECONDS=0.6
FETCH_CONCURRENCY=40

LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

WARMR_DATABASE_URL=
WARMR_SYNC_ENABLED=false
SYNC_VALUE_TIERS=high,medium
