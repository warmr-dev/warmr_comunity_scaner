# =============================================================================
# Railway — SearXNG invite harvest (high volume)
# =============================================================================

APP_ENV=production

DATABASE_URL=postgresql+psycopg://postgres.bpxiawuzidhjalaemejy:YOUR_DB_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

SCANNER_DATA_DIR=/app/data

BUNDLE_SEARXNG=true
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_LANGUAGE=en-US

DISCOVERY_PROVIDERS=searxng
DISCOVERY_CONCURRENCY=1

PIPE_GEO=USA
PIPE_LANGUAGE=non-ru
PIPE_AUDIENCE=developers
PIPE_NICHES=software-engineering,education,devops,cybersecurity,data-science,ai,saas,startups
PIPE_QUERIES=50
PIPE_PER_QUERY=25
PIPE_MAX_FETCH=200
NICHE_PAUSE_SECONDS=2
NICHE_LOOPS=20

USE_FETCH_QUEUE=false
SCANNER_MODE=run

HTTP_TIMEOUT_SECONDS=10
CRAWL_DOWNLOAD_DELAY_SECONDS=0.6
FETCH_CONCURRENCY=40

LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

WARMR_DATABASE_URL=
WARMR_SYNC_ENABLED=false
SYNC_VALUE_TIERS=high,medium,low
WARMR_TABLE_NAME=community_scanner
WARMR_UPSERT_KEY=canonical_key
