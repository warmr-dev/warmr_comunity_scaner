NICHE_LOOPS=10

USE_FETCH_QUEUE=false
SCANNER_MODE=run

HTTP_TIMEOUT_SECONDS=10
CRAWL_DOWNLOAD_DELAY_SECONDS=0.6
FETCH_CONCURRENCY=40
FETCH_BATCH_SIZE=500
WORKER_MAX_ITEMS=100000

LLM_ENABLED=false
OPENAI_API_KEY=
