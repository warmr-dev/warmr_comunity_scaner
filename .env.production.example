# =============================================================================
# Railway — reliable USA run targeting ~10k rows (one service, no Redis)
# =============================================================================

APP_ENV=production

DATABASE_URL=postgresql+psycopg://postgres.bpxiawuzidhjalaemejy:YOUR_DB_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

SCANNER_DATA_DIR=/app/data

BUNDLE_SEARXNG=true
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_LANGUAGE=en-US
DISCOVERY_PROVIDERS=searxng
DISCOVERY_CONCURRENCY=1

PIPE_GEO=USA
PIPE_AUDIENCE=professionals
# Many niches in ONE run (comma-separated)
PIPE_NICHES=accounting,law,finance,healthcare,real-estate,marketing,sales,hr,engineering,startups,founders,consulting,insurance,dental,veterinary,architecture,construction,education,coaching,creators
PIPE_QUERIES=12
PIPE_PER_QUERY=20
PIPE_MAX_FETCH=800
NICHE_PAUSE_SECONDS=30

USE_FETCH_QUEUE=false
SCANNER_MODE=run

HTTP_TIMEOUT_SECONDS=12
CRAWL_DOWNLOAD_DELAY_SECONDS=0
FETCH_CONCURRENCY=20

LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

WARMR_DATABASE_URL=
WARMR_SYNC_ENABLED=false
SYNC_VALUE_TIERS=high,medium,low
WARMR_TABLE_NAME=community_scanner
WARMR_UPSERT_KEY=canonical_key

# Resources: 2 vCPU / 2 GB is enough for 10k
# Expected: ~2–6 hours, Railway cost ~$0.50–$3
