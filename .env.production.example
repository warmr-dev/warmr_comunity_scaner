# =============================================================================
# Railway — Telegram + WhatsApp, IT / education priority
# =============================================================================

APP_ENV=production

DATABASE_URL=postgresql+psycopg://postgres.bpxiawuzidhjalaemejy:YOUR_DB_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

SCANNER_DATA_DIR=/app/data

BUNDLE_SEARXNG=true
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_LANGUAGE=en-US
DISCOVERY_PROVIDERS=searxng
DISCOVERY_CONCURRENCY=1

PIPE_GEO=USA
PIPE_AUDIENCE=professionals
# IT + education only (not full USA niche list)
PIPE_NICHES=it,education,software-engineering,devops,cybersecurity,data-science,ai,cloud-computing,data-engineering,devtools,ai-founders,mlops,saas,startups,programming,developers,coding,tech,edtech,online-learning,teachers,university,bootcamp,computer-science
PIPE_QUERIES=28
PIPE_PER_QUERY=25
PIPE_MAX_FETCH=150
NICHE_PAUSE_SECONDS=2
NICHE_LOOPS=50

USE_FETCH_QUEUE=false
SCANNER_MODE=run

HTTP_TIMEOUT_SECONDS=10
CRAWL_DOWNLOAD_DELAY_SECONDS=0.5
FETCH_CONCURRENCY=40

LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

WARMR_DATABASE_URL=
WARMR_SYNC_ENABLED=false
SYNC_VALUE_TIERS=high,medium,low
WARMR_TABLE_NAME=community_scanner
WARMR_UPSERT_KEY=canonical_key

# Only Telegram / WhatsApp join URLs are upserted. Discord disabled.
# Resources: 2 vCPU / 2 GB
