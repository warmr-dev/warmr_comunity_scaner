# =============================================================================
# Railway — ONE service (scanner + bundled SearXNG, no Redis)
# Supabase = external DATABASE_URL
# =============================================================================

APP_ENV=production

DATABASE_URL=postgresql+psycopg://postgres.bpxiawuzidhjalaemejy:YOUR_DB_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

SCANNER_DATA_DIR=/app/data

# SearXNG runs inside the same container (127.0.0.1:8080)
BUNDLE_SEARXNG=true
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_LANGUAGE=en-US
DISCOVERY_PROVIDERS=searxng
DISCOVERY_CONCURRENCY=2
PIPE_QUERIES=8
PIPE_PER_QUERY=15
PIPE_MAX_FETCH=200
FETCH_CONCURRENCY=20

LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

WARMR_DATABASE_URL=
WARMR_SYNC_ENABLED=false
SYNC_VALUE_TIERS=high,medium,low
WARMR_TABLE_NAME=community_scanner
WARMR_UPSERT_KEY=canonical_key

# Cron on Railway: 0 6,18 * * *
# Only ONE service needed: warmr_comunity_scaner (GitHub repo, root Dockerfile)
