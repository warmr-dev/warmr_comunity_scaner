# =============================================================================
# Railway — one reliable USA run targeting ~10k Supabase rows
# =============================================================================

APP_ENV=production

DATABASE_URL=postgresql+psycopg://postgres.bpxiawuzidhjalaemejy:YOUR_DB_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

SCANNER_DATA_DIR=/app/data

BUNDLE_SEARXNG=true
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_LANGUAGE=en-US
DISCOVERY_PROVIDERS=searxng
DISCOVERY_CONCURRENCY=1

PIPE_GEO=USA
PIPE_AUDIENCE=professionals
# auto = load ~320 niches from niches_usa.txt in the image
PIPE_NICHES=auto
PIPE_QUERIES=10
PIPE_PER_QUERY=20
PIPE_MAX_FETCH=1500
# Longer pause reduces Bing/SearXNG rate-limits from Railway IPs
NICHE_PAUSE_SECONDS=45

USE_FETCH_QUEUE=false
SCANNER_MODE=run

HTTP_TIMEOUT_SECONDS=15
CRAWL_DOWNLOAD_DELAY_SECONDS=2
FETCH_CONCURRENCY=20

LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

WARMR_DATABASE_URL=
WARMR_SYNC_ENABLED=false
SYNC_VALUE_TIERS=high,medium,low
WARMR_TABLE_NAME=community_scanner
WARMR_UPSERT_KEY=canonical_key

# Expected: ~6–12 hours, ~10k rows, Railway ~$1–5
# Resources: 2 vCPU / 2 GB
