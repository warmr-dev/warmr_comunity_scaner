# =============================================================================

# Railway — volume invite harvest: Telegram + WhatsApp + Slack + Discord (IT)

# =============================================================================



APP_ENV=production



DATABASE_URL=postgresql+psycopg://postgres.bpxiawuzidhjalaemejy:YOUR_DB_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres



SCANNER_DATA_DIR=/app/data



BUNDLE_SEARXNG=true

SEARXNG_BASE_URL=http://127.0.0.1:8080

SEARXNG_LANGUAGE=en-US

DISCOVERY_PROVIDERS=directory

DISCOVERY_CONCURRENCY=1

DIRECTORY_MAX_CHANNELS_PER_SITE=40



PIPE_GEO=USA

PIPE_AUDIENCE=developers

# IT + education niches (volume mode stores all shaped invite links)

PIPE_NICHES=it,education,software-engineering,devops,cybersecurity,data-science,ai,cloud-computing,data-engineering,devtools,ai-founders,mlops,saas,startups,programming,developers,coding,tech,edtech,online-learning,bootcamp,computer-science,web-development,mobile-development,open-source,machine-learning

PIPE_QUERIES=50

PIPE_PER_QUERY=25

PIPE_MAX_FETCH=200

NICHE_PAUSE_SECONDS=2

NICHE_LOOPS=50



USE_FETCH_QUEUE=false

SCANNER_MODE=run



HTTP_TIMEOUT_SECONDS=10

CRAWL_DOWNLOAD_DELAY_SECONDS=0.5

FETCH_CONCURRENCY=40



LLM_ENABLED=false

OPENAI_API_KEY=

LLM_MODEL=gpt-4o-mini



WARMR_DATABASE_URL=

WARMR_SYNC_ENABLED=false

SYNC_VALUE_TIERS=high,medium,low

WARMR_TABLE_NAME=community_scanner

WARMR_UPSERT_KEY=canonical_key



# Direct directory crawl (tgstat/disboard/discordservers) + 100+ member filter.

# Optional: DISCOVERY_PROVIDERS=directory,searxng to combine with Bing search.

# Resources: 2 vCPU / 2 GB

