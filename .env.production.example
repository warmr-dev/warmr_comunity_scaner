# =============================================================================
# Railway — free-tier mass fill (Common Crawl + Hive), 24/7
# Goal: grow community_scanner toward ~100k without paid SERP APIs.
# =============================================================================

APP_ENV=production

DATABASE_URL=postgresql+psycopg://postgres.bpxiawuzidhjalaemejy:YOUR_DB_PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

SCANNER_DATA_DIR=/app/data

# Mass mode does not need SearXNG — saves RAM/CPU on Railway.
BUNDLE_SEARXNG=false
SEARXNG_BASE_URL=http://127.0.0.1:8080
SEARXNG_LANGUAGE=en-US

DISCOVERY_PROVIDERS=commoncrawl,hive
DISCOVERY_CONCURRENCY=1

COMMONCRAWL_INDEX=latest
# Offset is auto-bumped each cycle via /app/data/cc_index_offset (volume recommended).
COMMONCRAWL_INDEX_OFFSET=0
COMMONCRAWL_MAX_PAGES_PER_PATTERN=30
COMMONCRAWL_PAGE_SIZE=400
COMMONCRAWL_DELAY_MS=450
COMMONCRAWL_MIN_LIKELIHOOD=0.45
COMMONCRAWL_PERSIST_RESUME=true

HIVE_MAX_DETAIL_PAGES=400
HIVE_EXCLUDE_DISCORD_TELEGRAM=true
SAVE_RAW_CANDIDATES=true
RAW_MIN_LIKELIHOOD=0.4

# Optional paid (leave empty on free tier): DATAFORSEO_* / BRAVE_SEARCH_API_KEY

HARVEST_MODE=true
HARVEST_SKIP_ENRICH=true

PIPE_GEO=USA
PIPE_LANGUAGE=non-ru
PIPE_AUDIENCE=professionals
PIPE_NICHES=harvest
# budget ≈ PIPE_QUERIES * PIPE_PER_QUERY candidates per cycle
PIPE_QUERIES=80
PIPE_PER_QUERY=100
PIPE_MAX_FETCH=5000
NICHE_PAUSE_SECONDS=1
# 0 = infinite cycles (24/7)
NICHE_LOOPS=0
LOOP_PAUSE_SECONDS=30

USE_FETCH_QUEUE=false
SCANNER_MODE=mass

HTTP_TIMEOUT_SECONDS=20
CRAWL_DOWNLOAD_DELAY_SECONDS=0.25
FETCH_CONCURRENCY=60
FETCH_BATCH_SIZE=500
WORKER_MAX_ITEMS=100000

LLM_ENABLED=false
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

WARMR_DATABASE_URL=
WARMR_SYNC_ENABLED=false
SYNC_VALUE_TIERS=high,medium,low
WARMR_TABLE_NAME=community_scanner
WARMR_UPSERT_KEY=canonical_key
